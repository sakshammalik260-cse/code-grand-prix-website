              "raw": "{\n  \"problemId\": \"speed-trap-detection\",\n  \"language\": \"javascript\",\n  \"sourceCode\": \"const fs = require('fs'); const [n, s, ...v] = fs.readFileSync(0, 'utf-8').trim().split(/\\\\s+/).map(Number); let count = 0, maxV = 0; for(const x of v){ if(x > s) count++; if(x > maxV) maxV = x; } console.log(count + ' ' + maxV);\",\n  \"customInput\": \"5 320\\n310 325 330 315 340\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/code/run" }
