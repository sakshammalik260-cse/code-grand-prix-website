// ==============================================================================
// CODE GRAND PRIX 2026 — PRISMA DATABASE SCHEMA (POSTGRESQL)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum Role {
  CANDIDATE
  PARTICIPANT
  VOLUNTEER
  ADMIN
}

enum ContestStatus {
  UPCOMING
  WAITING
  LIVE
  PAUSED
  PAUSED_BY_ORGANIZER
  ENDED
  FINISHED
}

enum CheckinStatus {
  NOT_STARTED
  PENDING
  READY
  BLOCKED
}

enum RaceSessionStatus {
  WAITING
  ACTIVE
  LOCK_PENDING
  LOCKED
  UNDER_REVIEW
  RESUME_AUTHORIZED
  FINISHED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  HIDDEN
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum Verdict {
  QUEUED
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
  INTERNAL_ERROR
}

enum IncidentType {
  TAB_HIDDEN
  WINDOW_BLUR
  WINDOW_FOCUS_LOST
  FULLSCREEN_EXIT
  CAMERA_INTERRUPTED
  CAMERA_TRACK_ENDED
  CAMERA_PERMISSION_DENIED
  NETWORK_RECONNECT
}

enum IncidentAction {
  LOCK
  LOG_ONLY
}

enum IncidentStatus {
  OPEN
  RESOLVED
  AUTHORIZED
  DISMISSED
}

// ------------------------------------------------------------------------------
// MODELS
// ------------------------------------------------------------------------------

model User {
  id           String      @id @default(uuid())
  driverId     String      @unique // e.g. CGP_045, VOL_RACE_CONTROL, ADMIN_01
  passwordHash String
  displayName  String
  team         String?     @default("CPC Grid")
  role         Role        @default(CANDIDATE)
  lastLogoutAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions     Session[]
  submissions  Submission[]
  incidents    Incident[]  @relation("ParticipantIncidents")
  auditLogs    AuditLog[]  @relation("VolunteerAuditLogs")
  drafts       Draft[]
  hintReceipts HintReceipt[]

  @@map("users")
}

model Contest {
  id             String        @id // e.g. "cgp_2026"
  title          String
  status         ContestStatus @default(LIVE)
  resultsVisible Boolean       @default(true)
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sessions       Session[]
  problems       Problem[]
  hintReceipts   HintReceipt[]

  @@map("contests")
}

model Session {
  id                  String            @id @default(uuid())
  userId              String
  contestId           String
  status              RaceSessionStatus @default(WAITING)
  revision            Int               @default(1)
  checkinStatus       CheckinStatus     @default(NOT_STARTED)
  rulesAccepted       Boolean           @default(false)
  cameraPermission    Boolean           @default(false)
  fullscreenRequested Boolean           @default(false)
  cameraStatus        String            @default("DISCONNECTED")
  lastSeenAt          DateTime          @default(now())
  lockCount           Int               @default(0)
  lockReason          String?
  lockedAt            DateTime?
  resumedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest             Contest           @relation(fields: [contestId], references: [id], onDelete: Cascade)
  incidents           Incident[]

  @@unique([userId, contestId])
  @@map("sessions")
}

model Problem {
  id                     String        @id @default(uuid())
  contestId              String
  slug                   String        @unique
  title                  String
  difficulty             Difficulty
  points                 Int           // 100, 250, 500
  order                  Int           @default(1)
  revision               Int           @default(1)
  status                 ProblemStatus @default(PUBLISHED)
  statement              String        @db.Text
  inputFormat            String        @db.Text
  outputFormat           String        @db.Text
  constraints            String        @db.Text
  timeLimitMs            Int           @default(2000)
  memoryLimitMb          Int           @default(256)
  allowedLanguages       String[]      @default(["python", "javascript", "cpp", "java"])
  expectedTimeComplexity String?       @default("O(n)")
  expectedSpaceComplexity String?      @default("O(1)")
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  contest                Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  testCases              TestCase[]
  submissions            Submission[]
  drafts                 Draft[]
  hints                  Hint[]
  hintReceipts           HintReceipt[]

  @@map("problems")
}

model TestCase {
  id             String   @id @default(uuid())
  problemId      String
  input          String   @db.Text
  expectedOutput String   @db.Text
  isPublic       Boolean  @default(false) // Public sample test vs Hidden private test
  explanation    String?  @db.Text
  weight         Int?     @default(1)
  order          Int      @default(1)
  createdAt      DateTime @default(now())

  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model Hint {
  id              String        @id @default(uuid())
  problemId       String
  order           Int           @default(1)
  deductionPoints Int           @default(10) // Points subtracted from problem score
  content         String        @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  problem         Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  receipts        HintReceipt[]

  @@map("hints")
}

model HintReceipt {
  id               String   @id @default(uuid())
  operationId      String   @unique
  contestId        String
  userId           String
  problemId        String
  hintId           String
  deductionApplied Int
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest          Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem          Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  hint             Hint     @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId, problemId, hintId])
  @@map("hint_receipts")
}

model Submission {
  id          String           @id @default(uuid())
  userId      String
  problemId   String
  languageId  String
  sourceCode  String           @db.Text
  status      SubmissionStatus @default(QUEUED)
  verdict     Verdict          @default(QUEUED)
  score       Int              @default(0)
  passedTests Int              @default(0)
  totalTests  Int              @default(0)
  runtimeMs   Int?
  memoryKb    Int?
  message     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
  @@map("submissions")
}

model Incident {
  id               String         @id @default(uuid())
  eventId          String         @unique // clientEventId
  userId           String
  sessionId        String
  problemId        String?
  type             IncidentType
  action           IncidentAction
  status           IncidentStatus @default(OPEN)
  blocking         Boolean        @default(true)
  occurredAt       DateTime
  receivedAt       DateTime       @default(now())
  details          String?        @db.Text
  resolvedAt       DateTime?
  resolvedBy       String?
  resolutionAction String?
  resolutionReason String?

  user             User           @relation("ParticipantIncidents", fields: [userId], references: [id], onDelete: Cascade)
  session          Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  auditLogs        AuditLog[]

  @@index([userId, status])
  @@map("incidents")
}

model AuditLog {
  id            String    @id @default(uuid())
  volunteerId   String
  incidentId    String?
  participantId String?
  sessionId     String?
  action        String    // APPROVE_RESUME, BULK_RESUME, KEEP_LOCKED, DISMISS, etc.
  reason        String
  previousState String?   @db.Text
  newState      String?   @db.Text
  createdAt     DateTime  @default(now())

  volunteer     User      @relation("VolunteerAuditLogs", fields: [volunteerId], references: [id], onDelete: Cascade)
  incident      Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Draft {
  id         String   @id @default(uuid())
  userId     String
  problemId  String
  languageId String
  code       String   @db.Text
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId, languageId])
  @@map("drafts")
}

model RevokedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("revoked_tokens")
}
