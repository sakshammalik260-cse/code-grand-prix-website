# Frontend-only configuration. Never put secrets in Vite environment values.
# Mock mode is development-only. Select API mode to use the local backend.
# Only explicitly setting VITE_ARENA_MODE=api enables backend requests.
# Use npm run dev for mocks; an unconfigured production preview never uses mocks.
VITE_ARENA_MODE=mock
# Production uses /api on the same HTTPS origin, or an approved HTTPS API origin with /api.
VITE_API_BASE_URL=/api
# Server-side Vite setting. Proxies requests without changing their /api path.
CGP_API_PROXY_TARGET=http://127.0.0.1:4000

# Monitoring polling interval in milliseconds (1000-30000).
VITE_MONITORING_POLL_MS=2000
