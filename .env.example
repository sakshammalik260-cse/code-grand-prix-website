# ==============================================================================
# CODE GRAND PRIX 2026 — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server network settings. Production uses the externally reachable HTTPS origin.
PORT=4000
# Keep Express on loopback when the HTTPS proxy shares this host.
CGP_BIND_ADDRESS=127.0.0.1
NODE_ENV=development
API_BASE_URL=http://localhost:4000
# Production requires the specific trusted reverse-proxy IP addresses or CIDRs.
TRUST_PROXY=

# CORS & Frontend Origins (Comma-separated for multiple origins)
# Example: http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database Connection (PostgreSQL)
# Option A - Local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cgp_2026?schema=public"
# Option B - Supabase PostgreSQL (replace with your project credentials):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

ALLOW_DEV_FALLBACK=false

# Authentication & Security
# Generate a strong 256-bit random secret in production
JWT_SECRET="cgp-2026-super-secret-development-jwt-key-replace-in-prod"
JWT_EXPIRES_IN="8h"
COOKIE_SECRET="cgp-2026-cookie-secret-key-replace-in-prod"
# Set to "true" in production with HTTPS:
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
# Development defaults to memory; production requires the shared PostgreSQL store.
# LOGIN_RATE_LIMIT_STORE=postgres
# Failed and in-flight login budget per source per 15 minutes.
LOGIN_SOURCE_LIMIT=250

# Contest Clock Configuration
CONTEST_ID="cgp_2026"
# ISO 8601 UTC contest start and end times
CONTEST_START_TIME="2026-11-23T05:30:00Z"
CONTEST_END_TIME="2026-11-23T08:30:00Z"
CONTEST_STATUS="LIVE" # Options: UPCOMING, LIVE, PAUSED, ENDED

# Code Execution & Judging Provider
# Options: "local" (trusted repository test fixtures only), "judge0", or "piston".
JUDGE_PROVIDER="local"
# Set JUDGE_PROVIDER="judge0" for Judge0 or "piston" for a dedicated Piston instance.
JUDGE0_AUTH_MODE="self-hosted"
JUDGE0_API_URL="http://localhost:2358"
JUDGE0_AUTH_HEADER="X-Auth-Token"
JUDGE0_API_KEY=""
# For hosted CE, set JUDGE0_AUTH_MODE="rapidapi" and use the official HTTPS gateway.
# JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
# JUDGE0_RAPIDAPI_HOST="judge0-ce.p.rapidapi.com"
# JUDGE0_RAPIDAPI_KEY=""
# Piston base origin. Use loopback/SSH tunnel or authenticated HTTPS on a private network.
# PISTON_API_URL="http://127.0.0.1:2000"
# PISTON_API_TOKEN=""
# PISTON_PYTHON_VERSION=
# PISTON_JAVA_VERSION=
# Optional CPU allowance for a pinned Java runtime that compiles within its run stage.
# It applies to the entire Java stage, and leaves the problem memory limit unchanged.
# PISTON_JAVA_SOURCE_CPU_ALLOWANCE_MS=0
# PISTON_CPP_VERSION=
# PISTON_JAVASCRIPT_VERSION=
# PISTON_COMPILE_MEMORY_MB=512
# Match the approved worker ceiling. The two-job rehearsal profile uses 1024 MiB.
# PISTON_MAX_RUN_MEMORY_MB=1024
# Set exact /languages names if several versions of a language are enabled.
# JUDGE0_LANGUAGE_PYTHON=
# JUDGE0_LANGUAGE_JAVA=
# JUDGE0_LANGUAGE_CPP=
# JUDGE0_LANGUAGE_JAVASCRIPT=
JUDGE0_HTTP_TIMEOUT_MS=4000
JUDGE0_JOB_TIMEOUT_MS=150000
JUDGE0_POLL_INTERVAL_MS=250
JUDGE_REQUEST_TIMEOUT_MS=180000
# Use 2 for the initial Piston rehearsal profile.
JUDGE_MAX_CONCURRENT_REQUESTS=4
JUDGE_MAX_CASES=100

# Execution Guardrails
MAX_SOURCE_CODE_BYTES=65536 # 64 KB limit
DEFAULT_TIME_LIMIT_MS=2000
DEFAULT_MEMORY_LIMIT_MB=256
MAX_OUTPUT_BYTES=65536 # 64 KB stdout/stderr cap

# Competition Scoring Rules (F1 / ICPC competitive model)
# Points per problem: Easy=100, Medium=250, Hard=500
POINTS_EASY=100
POINTS_MEDIUM=250
POINTS_HARD=500
# Penalty added in minutes for each wrong submission before first accepted
WRONG_SUBMISSION_PENALTY_MINUTES=20

# Incident & Anti-Cheating Policy
# Critical events immediately trigger session LOCK:
CRITICAL_INCIDENT_TYPES="TAB_HIDDEN,FULLSCREEN_EXIT,CAMERA_TRACK_ENDED"
# Non-critical events are logged without locking:
LOG_ONLY_INCIDENT_TYPES="WINDOW_BLUR,NETWORK_RECONNECT"
