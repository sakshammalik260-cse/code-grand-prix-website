# ==============================================================================
# CODE GRAND PRIX 2026 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Never put private server secrets or database credentials in Vite env files.
# Vite prefixes exposed to the client must start with VITE_.
# ==============================================================================

# --- ARENA OPERATION MODE ---
# Options:
#   'mock' - (Development only) Uses in-memory browser simulation for driver logins,
#            mock questions, client-side code runner, and simulated monitoring.
#   'api'  - Connects to the real Code Grand Prix 2026 backend API.
# Note: Production builds default to 'api' mode unless explicitly set to 'mock'.
VITE_ARENA_MODE=mock

# --- BACKEND API BASE URL ---
# The base URL endpoint for all REST API routes (/auth, /contest, /code, /admin, etc.)
# Default: /api (works with Vite dev proxy and production reverse proxies)
# For cross-origin deployment: https://api.codegrandprix.com/api
VITE_API_BASE_URL=/api

# --- LOCAL DEV PROXY TARGET (Vite dev server only) ---
# Used by vite.config.ts to forward /api requests to your backend server during development.
# Default backend port is 4000.
VITE_BACKEND_URL=http://localhost:4000

# --- MONITORING HEARTBEAT & INCIDENT POLLING ---
# Polling interval in milliseconds for candidate heartbeat and race control review (1000-30000).
VITE_MONITORING_POLL_MS=2000

# --- BRAND INTRO REPLAY (QA & Motion Testing) ---
# true  - Replays the cinematic F1 brand intro on every page load.
# false - Plays once per browser session on the landing page route.
VITE_REPLAY_BRAND_INTRO=false
